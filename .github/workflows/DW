name: Update Dorsey Wright RS

on:
  schedule:
    - cron: "30 12 * * 1-5"      # 6:00 PM IST, Mon-Fri: Indian stocks and Indian ETFs (after the NSE close)
    - cron: "30 22 * * 1-5"      # 4:00 AM IST: Global ETFs (after the US close)
  workflow_dispatch:             # lets you run it manually from the Actions tab
    inputs:
      which:
        description: "What to score: all, or any of stocks, india_etf, global_etf (separated by spaces)"
        default: "all"

permissions:
  contents: write

# only one run at a time; a newer one waits its turn
concurrency:
  group: dorsey-wright
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 150         # a run that takes longer than this is stuck, so it is stopped instead of blocking the next ones
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install yfinance pandas numpy openpyxl curl_cffi
      - name: Score
        env:
          WHICH: ${{ github.event.inputs.which }}
          SCHEDULE: ${{ github.event.schedule }}
        run: |
          if [ -n "$WHICH" ] && [ "$WHICH" != "all" ]; then LIST="$WHICH"
          elif [ "$SCHEDULE" = "30 22 * * 1-5" ]; then LIST="global_etf"
          elif [ -n "$SCHEDULE" ]; then LIST="stocks india_etf"
          else LIST="stocks india_etf global_etf"; fi
          echo "Scoring: $LIST"
          python scan_dw.py $LIST
      - name: Commit results
        run: |
          git config user.name  "github-actions"
          git config user.email "actions@github.com"
          mkdir -p /tmp/keep
          cp -f data/dw_*.json data/dwq_*.json /tmp/keep/ 2>/dev/null || true
          git add data/dw_stocks.json 2>/dev/null || true
          git add data/dw_india_etf.json 2>/dev/null || true
          git add data/dw_global_etf.json 2>/dev/null || true
          git add data/dwq_stocks.json 2>/dev/null || true
          git add data/dwq_india_etf.json 2>/dev/null || true
          git add data/dwq_global_etf.json 2>/dev/null || true
          git diff --staged --quiet || git commit -q -m "Update Dorsey Wright RS"
          for attempt in 1 2 3 4 5; do
            git push && break
            echo "Push attempt $attempt failed - taking the latest main and re-applying the new data..."
            git fetch -q origin main
            git reset -q --hard origin/main
            cp -f /tmp/keep/dw*.json data/ 2>/dev/null || true
            git add data/dw_stocks.json 2>/dev/null || true
            git add data/dw_india_etf.json 2>/dev/null || true
            git add data/dw_global_etf.json 2>/dev/null || true
            git add data/dwq_stocks.json 2>/dev/null || true
            git add data/dwq_india_etf.json 2>/dev/null || true
            git add data/dwq_global_etf.json 2>/dev/null || true
            git diff --staged --quiet || git commit -q -m "Update Dorsey Wright RS"
            sleep 5
          done
